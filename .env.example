# Quill workspace. Copy to .env; never commit actual credentials.
QUILL_DATA_DIR=./data
QUILL_KNOWLEDGE_URL=http://127.0.0.1:8006
QUILL_KNOWLEDGE_TOKEN=
# Required for shared/network access. Empty is allowed only for loopback-only development.
QUILL_API_KEY=
QUILL_LLM_BASE_URL=https://api.openai.com/v1
QUILL_LLM_API_KEY=
QUILL_LLM_MODEL=
QUILL_LLM_TIMEOUT=120
QUILL_LLM_MAX_TOKENS=4096

# Docker Compose: set a strong password and access key before starting.
POSTGRES_PASSWORD=
QUILL_EMBEDDING_MODEL=text-embedding-3-small
QUILL_EMBEDDING_DIMENSION=1536
